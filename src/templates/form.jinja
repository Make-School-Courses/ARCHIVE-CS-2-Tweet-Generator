<form
	id="generate-form"
	class="surface"
	action="/tweet-generator/generate"
	method="post"
>
	<button type="submit">
		<span id="generate-label">Generate a Phrase!</span>
		<span id="loading-status" role="status" aria-live="polite" hidden>
			<span class="loading-spinner" aria-hidden="true"></span>
			Generating tweet...
		</span>
	</button>
</form>

<section
	id="generation-error"
	class="surface error-panel"
	role="alert"
	aria-labelledby="generation-error-title"
	hidden
>
	<h2 id="generation-error-title">Phrase generation failed</h2>
	<p>
		<span id="generation-error-message">
			{# JavaScript will fill this line in with a message. #}
		</span>
		<a href="https://github.com/noltron000/tweet-generator/issues/new">
			Report this issue on GitHub.
		</a>
	</p>
</section>
